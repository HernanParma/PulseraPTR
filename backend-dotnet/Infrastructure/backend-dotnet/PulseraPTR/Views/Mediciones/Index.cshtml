@model MedicionesIndexDto
@{
    ViewData["Title"] = "Mediciones";
    var pacientes = ViewBag.Pacientes as IReadOnlyList<PacienteDto> ?? Array.Empty<PacienteDto>();
    int? filtroPaciente = ViewBag.PacienteId as int?;
    string? filtroDesde = ViewBag.FechaDesde as string;
    string? filtroHasta = ViewBag.FechaHasta as string;
    var filtroEstado = ViewBag.Estado as EstadoClinico?;

    var filas = Model.Filas;
    var medicionesPulsera = Model.MedicionesPulsera;
    var totalFilas = Model.TotalFilas;
    var pagina = Model.Pagina;
    var totalPaginas = Model.TotalPaginas;

    var totalMediciones = totalFilas;
    var medicionesConFc = medicionesPulsera.Where(m => m.FrecuenciaCardiaca > 0).ToList();
    var fcPromedio = medicionesConFc.Any() ? (int)medicionesConFc.Average(m => m.FrecuenciaCardiaca) : 0;
    var fcMin = medicionesConFc.Any() ? medicionesConFc.Min(m => m.FrecuenciaCardiaca) : 0;
    var fcMax = medicionesConFc.Any() ? medicionesConFc.Max(m => m.FrecuenciaCardiaca) : 0;

    var medicionesConPasos = medicionesPulsera.Where(m => m.PasosActividad.HasValue && m.PasosActividad > 0).ToList();
    var hoy = DateTime.Today;
    var pasosMaxHoy = medicionesConPasos
        .Where(m => m.FechaHora.Date == hoy)
        .Select(m => m.PasosActividad!.Value)
        .DefaultIfEmpty(0)
        .Max();

    var medicionesConEstres = medicionesPulsera.Where(m => m.NivelEstres.HasValue).ToList();
    var estresPromedio = medicionesConEstres.Any() ? (int)medicionesConEstres.Average(m => m.NivelEstres!.Value) : 0;

    var medicionesConSueno = medicionesPulsera.Where(m => m.MinutosSueno.HasValue).ToList();
    var suenoPromedioMin = medicionesConSueno.Any() ? (int)medicionesConSueno.Average(m => m.MinutosSueno!.Value) : 0;
    var suenoHoras = suenoPromedioMin / 60;
    var suenoMinutos = suenoPromedioMin % 60;

    var medicionesConActividad = medicionesPulsera.Where(m => m.MinutosActividad.HasValue).ToList();
    var actividadPromedio = medicionesConActividad.Any() ? (int)medicionesConActividad.Average(m => m.MinutosActividad!.Value) : 0;

    var medicionesConCalorias = medicionesPulsera.Where(m => m.CaloriasQuemadas.HasValue).ToList();
    var caloriasPromedio = medicionesConCalorias.Any() ? (int)medicionesConCalorias.Average(m => m.CaloriasQuemadas!.Value) : 0;

    var pacienteSeleccionado = filtroPaciente.HasValue
        ? pacientes.FirstOrDefault(p => p.Id == filtroPaciente.Value)?.Nombre ?? $"Paciente {filtroPaciente}"
        : "Todos";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-0">Mediciones</h1>
        <p class="text-muted mb-0">Listado completo con filtros</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Limpiar filtros</a>
</div>

<!-- Filtros -->
<form class="card shadow-sm mb-4" method="get">
    <div class="card-body row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Paciente</label>
            <select class="form-select" name="pacienteId">
                <option value="">Todos</option>
                @foreach (var p in pacientes)
                {
                    if (filtroPaciente == p.Id)
                    {
                        <option value="@p.Id" selected>@p.Nombre</option>
                    }
                    else
                    {
                        <option value="@p.Id">@p.Nombre</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Desde</label>
            <input class="form-control" type="datetime-local" name="fechaDesde" value="@filtroDesde" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Hasta</label>
            <input class="form-control" type="datetime-local" name="fechaHasta" value="@filtroHasta" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Estado</label>
            <select class="form-select" name="estado">
                <option value="">Todos</option>
                @foreach (EstadoClinico e in Enum.GetValues(typeof(EstadoClinico)))
                {
                    if (filtroEstado == e)
                    {
                        <option value="@e" selected>@e</option>
                    }
                    else
                    {
                        <option value="@e">@e</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-1 d-grid">
            <button class="btn btn-primary" type="submit">Filtrar</button>
        </div>
    </div>
</form>

<!-- Cards de resumen -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-2">
        <div class="card metric-card h-100">
            <div class="card-body text-center">
                <div class="metric-label">Mediciones</div>
                <div class="metric-value text-primary">@totalMediciones</div>
                <div class="metric-sub">filtro actual</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card metric-card h-100">
            <div class="card-body text-center">
                <div class="metric-label">FC promedio</div>
                <div class="metric-value text-danger">@(fcPromedio > 0 ? fcPromedio.ToString() : "—")</div>
                <div class="metric-sub">@(fcPromedio > 0 ? "lpm" : "sin dato")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card metric-card h-100">
            <div class="card-body text-center">
                <div class="metric-label">Pasos</div>
                <div class="metric-value text-success">@(pasosMaxHoy > 0 ? pasosMaxHoy.ToString("N0") : "—")</div>
                <div class="metric-sub">@(pasosMaxHoy > 0 ? $"máximo del día {hoy:dd/MM/yyyy}" : "sin pasos hoy")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card metric-card h-100">
            <div class="card-body text-center">
                <div class="metric-label">Estrés promedio</div>
                <div class="metric-value text-secondary">@(estresPromedio > 0 ? estresPromedio.ToString() : "—")</div>
                <div class="metric-sub">@(estresPromedio > 0 ? "pts (0-100)" : "sin dato")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card metric-card h-100">
            <div class="card-body text-center">
                <div class="metric-label">Sueño promedio</div>
                <div class="metric-value text-info">@(suenoPromedioMin > 0 ? $"{suenoHoras}h {suenoMinutos}m" : "—")</div>
                <div class="metric-sub">@(suenoPromedioMin > 0 ? $"{suenoPromedioMin} min" : "sin dato")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card metric-card h-100">
            <div class="card-body text-center">
                <div class="metric-label">Actividad</div>
                <div class="metric-value text-warning">@(actividadPromedio > 0 ? $"{actividadPromedio}" : "—")</div>
                <div class="metric-sub">@(caloriasPromedio > 0 ? $"{caloriasPromedio} kcal" : "sin dato")</div>
            </div>
        </div>
    </div>
</div>

<!-- Panel de gráficos -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <span class="fw-semibold">Panel de métricas del paciente</span>
            <br><small class="text-muted">Elegí un atributo para analizar su evolución con los filtros actuales · Paciente: @pacienteSeleccionado</small>
        </div>
        <div>
            <label class="form-label small mb-0 me-1">Métrica</label>
            <select class="form-select form-select-sm d-inline-block w-auto" id="metricSelect">
                <option value="fc">Frecuencia cardíaca</option>
                <option value="pasos">Pasos</option>
                <option value="estres">Estrés</option>
                <option value="sueno">Sueño</option>
                <option value="actividad">Actividad</option>
                <option value="calorias">Calorías</option>
                <option value="glucemia">Glucemia</option>
            </select>
        </div>
    </div>
    <div class="card-body">
        <!-- Botones de métrica -->
        <div class="d-flex flex-wrap gap-2 mb-4">
            <button class="btn btn-metric active" data-metric="fc">
                <i class="bi bi-heart-pulse-fill"></i> FC
            </button>
            <button class="btn btn-metric" data-metric="pasos">
                <i class="bi bi-person-walking"></i> Pasos
            </button>
            <button class="btn btn-metric" data-metric="estres">
                <i class="bi bi-emoji-neutral"></i> Estrés
            </button>
            <button class="btn btn-metric" data-metric="sueno">
                <i class="bi bi-moon-stars"></i> Sueño
            </button>
            <button class="btn btn-metric" data-metric="actividad">
                <i class="bi bi-lightning"></i> Actividad
            </button>
            <button class="btn btn-metric" data-metric="calorias">
                <i class="bi bi-fire"></i> Calorías
            </button>
            <button class="btn btn-metric" data-metric="glucemia">
                <i class="bi bi-droplet-fill"></i> Glucemia
            </button>
        </div>

        <!-- Título del gráfico -->
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
                <h5 class="mb-0" id="chartTitle">Frecuencia cardíaca</h5>
                <small class="text-muted" id="chartSubtitle">Latidos por minuto</small>
            </div>
            <div>
                <span class="badge bg-light text-dark border" id="chartDataCount">@medicionesConFc.Count datos</span>
            </div>
        </div>

        <!-- Resumen de la métrica seleccionada -->
        <div class="row mb-3">
            <div class="col-md-9">
                <canvas id="metricChart" height="280"></canvas>
            </div>
            <div class="col-md-3 d-flex align-items-center">
                <div class="p-3 bg-light rounded w-100 text-center" id="chartSummary">
                    <div class="text-muted small">Resumen seleccionado</div>
                    <div class="display-5 fw-bold text-primary" id="summaryValue">@(fcPromedio > 0 ? $"{fcPromedio} lpm" : "—")</div>
                    <div class="text-muted small" id="summaryDetail">
                        @(medicionesConFc.Any() ? $"Promedio {fcPromedio} lpm · mínimo {fcMin} lpm · máximo {fcMax} lpm" : "Sin datos")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de datos -->
<div class="card shadow-sm mediciones-resultados-card">
    <div class="card-header bg-white fw-semibold d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span>Resultados (@totalFilas)</span>
        <span class="text-muted small">
            Pulsera y glucemia mySugr · mostrando @Model.IndicePrimerRegistro–@Model.IndiceUltimoRegistro de @totalFilas
        </span>
    </div>
    <div class="table-responsive mediciones-table-wrap">
        <table class="table table-sm table-hover mb-0 align-middle mediciones-resultados-table">
            <thead class="table-light">
                <tr>
                    <th class="col-id" title="Identificador">Id</th>
                    <th class="col-fecha" title="Fecha y hora">Fecha / Hora</th>
                    <th class="col-paciente" title="Paciente">Paciente</th>
                    <th class="col-tipo" title="Tipo de registro">Tipo</th>
                    <th class="col-fc" title="Frecuencia cardíaca">FC</th>
                    <th class="col-gluc" title="Glucemia">Gluc.</th>
                    <th class="col-pasos" title="Pasos">Pasos</th>
                    <th class="col-estres" title="Estrés">Estrés</th>
                    <th class="col-sueno" title="Sueño">Sueño</th>
                    <th class="col-act" title="Actividad (minutos)">Act.</th>
                    <th class="col-cal" title="Calorías">Cal.</th>
                    <th class="col-estado" title="Estado clínico">Estado</th>
                    <th class="col-mensaje" title="Mensaje">Mensaje</th>
                    <th class="col-accion text-end" title="Eliminar"> </th>
                </tr>
            </thead>
            <tbody>
            @foreach (var f in filas)
            {
                var esGlucemia = f.Tipo == MedicionListadoTipo.Glucemia;
                <tr class="@(esGlucemia ? "table-row-glucemia" : "")">
                    <td class="col-id">@f.Id</td>
                    <td class="col-fecha">
                        <span class="medicion-fecha-dia">@f.FechaHora.ToString("dd/MM/yy")</span>
                        <span class="medicion-fecha-hora">@f.FechaHora.ToString("HH:mm")</span>
                    </td>
                    <td class="col-paciente text-break">@f.PacienteNombre</td>
                    <td class="col-tipo">
                        @if (esGlucemia)
                        {
                            <span class="badge bg-purple-subtle text-purple border badge-tipo-registro" style="--bs-bg-opacity:1;background-color:rgba(111,66,193,.12);color:#6f42c1">Gluc.</span>
                        }
                        else
                        {
                            <span class="badge bg-light text-dark border badge-tipo-registro">Pulsera</span>
                        }
                    </td>
                    <td class="col-fc">@(f.FrecuenciaCardiaca?.ToString() ?? "-")</td>
                    <td class="col-gluc text-nowrap">@(f.GlucemiaMgDl.HasValue ? $"{f.GlucemiaMgDl}" : "-")</td>
                    <td class="col-pasos">@(f.PasosActividad?.ToString("N0") ?? "-")</td>
                    <td class="col-estres">@(f.NivelEstres?.ToString() ?? "-")</td>
                    <td class="col-sueno text-nowrap">@(f.MinutosSueno.HasValue ? $"{f.MinutosSueno}m" : "-")</td>
                    <td class="col-act">@(f.MinutosActividad?.ToString() ?? "-")</td>
                    <td class="col-cal">@(f.CaloriasQuemadas?.ToString("N0") ?? "-")</td>
                    <td class="col-estado">
                        @if (f.Estado is null)
                        {
                            <span class="badge bg-light text-muted border">—</span>
                        }
                        else
                        {
                            <span class="badge badge-estado-@f.Estado">@f.Estado</span>
                        }
                    </td>
                    <td class="col-mensaje text-break" title="@(f.Mensaje ?? "")">@(f.Mensaje ?? "-")</td>
                    <td class="col-accion text-end">
                        @if (f.PuedeEliminar)
                        {
                            <form asp-action="Delete" asp-route-id="@f.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Eliminar esta medición de forma permanente?');">
                                @Html.AntiForgeryToken()
                                @if (filtroPaciente.HasValue)
                                {
                                    <input type="hidden" name="pacienteId" value="@filtroPaciente.Value" />
                                }
                                @if (!string.IsNullOrEmpty(filtroDesde))
                                {
                                    <input type="hidden" name="fechaDesde" value="@filtroDesde" />
                                }
                                @if (!string.IsNullOrEmpty(filtroHasta))
                                {
                                    <input type="hidden" name="fechaHasta" value="@filtroHasta" />
                                }
                                @if (filtroEstado.HasValue)
                                {
                                    <input type="hidden" name="estado" value="@filtroEstado.Value" />
                                }
                                @if (pagina > 1)
                                {
                                    <input type="hidden" name="pagina" value="@pagina" />
                                }
                                <button type="submit" class="btn btn-sm btn-link btn-icon-borrar p-0 border-0" title="Eliminar medición" aria-label="Eliminar medición">
                                    <i class="bi bi-trash fs-5"></i>
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small" title="Las lecturas mySugr se gestionan por importación">—</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white py-2">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="text-muted small mediciones-table-scroll-hint mb-0">
                Si no ves todas las columnas, deslizá horizontalmente sobre la tabla.
            </span>
            @if (totalPaginas > 1)
            {
                <nav aria-label="Paginación de resultados">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(pagina <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pacienteId="@filtroPaciente"
                               asp-route-fechaDesde="@filtroDesde"
                               asp-route-fechaHasta="@filtroHasta"
                               asp-route-estado="@filtroEstado"
                               asp-route-pagina="@(pagina - 1)">Anterior</a>
                        </li>
                        @{
                            var desdePag = Math.Max(1, pagina - 2);
                            var hastaPag = Math.Min(totalPaginas, pagina + 2);
                        }
                        @if (desdePag > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pacienteId="@filtroPaciente"
                                   asp-route-fechaDesde="@filtroDesde"
                                   asp-route-fechaHasta="@filtroHasta"
                                   asp-route-estado="@filtroEstado"
                                   asp-route-pagina="1">1</a>
                            </li>
                            @if (desdePag > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            }
                        }
                        @for (var p = desdePag; p <= hastaPag; p++)
                        {
                            <li class="page-item @(p == pagina ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pacienteId="@filtroPaciente"
                                   asp-route-fechaDesde="@filtroDesde"
                                   asp-route-fechaHasta="@filtroHasta"
                                   asp-route-estado="@filtroEstado"
                                   asp-route-pagina="@p">@p</a>
                            </li>
                        }
                        @if (hastaPag < totalPaginas)
                        {
                            @if (hastaPag < totalPaginas - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pacienteId="@filtroPaciente"
                                   asp-route-fechaDesde="@filtroDesde"
                                   asp-route-fechaHasta="@filtroHasta"
                                   asp-route-estado="@filtroEstado"
                                   asp-route-pagina="@totalPaginas">@totalPaginas</a>
                            </li>
                        }
                        <li class="page-item @(pagina >= totalPaginas ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pacienteId="@filtroPaciente"
                               asp-route-fechaDesde="@filtroDesde"
                               asp-route-fechaHasta="@filtroHasta"
                               asp-route-estado="@filtroEstado"
                               asp-route-pagina="@(pagina + 1)">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
(function() {
    // Datos de mediciones serializados desde el servidor
    const mediciones = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(medicionesPulsera.Select(m => new {
        fecha = m.FechaHora.ToString("yyyy-MM-dd HH:mm"),
        fc = m.FrecuenciaCardiaca,
        pasos = m.PasosActividad,
        estres = m.NivelEstres,
        sueno = m.MinutosSueno,
        actividad = m.MinutosActividad,
        calorias = m.CaloriasQuemadas
    }).OrderBy(m => m.fecha)));

    const pacienteId = @(filtroPaciente.HasValue ? filtroPaciente.Value.ToString() : "null");
    const pacientesGlucemia = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        pacientes.Select(p => new { id = p.Id, nombre = p.Nombre })));

    const ctx = document.getElementById('metricChart').getContext('2d');
    let chart = null;

    const metricConfig = {
        fc: {
            title: 'Frecuencia cardíaca',
            subtitle: 'Latidos por minuto',
            color: '#dc3545',
            bgColor: 'rgba(220, 53, 69, 0.1)',
            type: 'line',
            unit: 'lpm',
            getData: () => {
                const data = mediciones.filter(m => m.fc > 0);
                return { labels: data.map(m => m.fecha), values: data.map(m => m.fc) };
            }
        },
        pasos: {
            title: 'Pasos',
            subtitle: 'Máximo registrado por día (no se suman lecturas del mismo día)',
            color: '#198754',
            bgColor: 'rgba(25, 135, 84, 0.15)',
            type: 'bar',
            unit: 'pasos',
            getData: () => {
                const byDay = {};
                mediciones.filter(m => m.pasos != null && m.pasos > 0).forEach(m => {
                    const day = m.fecha.substring(0, 10);
                    byDay[day] = Math.max(byDay[day] || 0, m.pasos);
                });
                const labels = Object.keys(byDay).sort();
                return { labels, values: labels.map(d => byDay[d]) };
            }
        },
        estres: {
            title: 'Estrés',
            subtitle: 'Nivel de estrés (0-100)',
            color: '#fd7e14',
            bgColor: 'rgba(253, 126, 20, 0.12)',
            type: 'line',
            unit: 'pts',
            getData: () => {
                const data = mediciones.filter(m => m.estres != null);
                return { labels: data.map(m => m.fecha), values: data.map(m => m.estres) };
            }
        },
        sueno: {
            title: 'Sueño',
            subtitle: 'Minutos de sueño',
            color: '#0dcaf0',
            bgColor: 'rgba(13, 202, 240, 0.15)',
            type: 'bar',
            unit: 'min',
            getData: () => {
                const data = mediciones.filter(m => m.sueno != null);
                return { labels: data.map(m => m.fecha), values: data.map(m => m.sueno) };
            }
        },
        actividad: {
            title: 'Actividad',
            subtitle: 'Minutos de actividad física',
            color: '#ffc107',
            bgColor: 'rgba(255, 193, 7, 0.15)',
            type: 'bar',
            unit: 'min',
            getData: () => {
                const data = mediciones.filter(m => m.actividad != null);
                return { labels: data.map(m => m.fecha), values: data.map(m => m.actividad) };
            }
        },
        calorias: {
            title: 'Calorías',
            subtitle: 'Calorías quemadas',
            color: '#dc3545',
            bgColor: 'rgba(220, 53, 69, 0.1)',
            type: 'bar',
            unit: 'kcal',
            getData: () => {
                const data = mediciones.filter(m => m.calorias != null);
                return { labels: data.map(m => m.fecha), values: data.map(m => m.calorias) };
            }
        },
        glucemia: {
            title: 'Glucemia',
            subtitle: 'mg/dL (importación mySugr; también en la tabla de resultados)',
            color: '#6f42c1',
            bgColor: 'rgba(111, 66, 193, 0.1)',
            type: 'line',
            unit: 'mg/dL',
            getData: () => ({ labels: [], values: [], loading: true })
        }
    };

    function renderChart(metric) {
        const config = metricConfig[metric];
        if (!config) return;

        document.getElementById('chartTitle').textContent = config.title;
        document.getElementById('chartSubtitle').textContent = config.subtitle;

        // Actualizar botones
        document.querySelectorAll('.btn-metric').forEach(btn => btn.classList.remove('active'));
        const activeBtn = document.querySelector(`[data-metric="${metric}"]`);
        if (activeBtn) activeBtn.classList.add('active');
        document.getElementById('metricSelect').value = metric;

        if (metric === 'glucemia') {
            loadGlucemiaChart();
            return;
        }

        const { labels, values } = config.getData();
        document.getElementById('chartDataCount').textContent = `${values.length} datos`;

        if (values.length === 0) {
            updateSummary('—', 'Sin datos disponibles para esta métrica');
            drawEmptyChart(config);
            return;
        }

        const avg = Math.round(values.reduce((a, b) => a + b, 0) / values.length);
        const min = Math.min(...values);
        const max = Math.max(...values);
        updateSummary(`${avg} ${config.unit}`, `Promedio ${avg} ${config.unit} · mínimo ${min} ${config.unit} · máximo ${max} ${config.unit}`);

        if (chart) chart.destroy();

        const borderColor = config.color;
        const backgroundColor = config.type === 'bar' ? config.bgColor : config.bgColor;

        chart = new Chart(ctx, {
            type: config.type,
            data: {
                labels: labels,
                datasets: [{
                    label: config.title,
                    data: values,
                    borderColor: borderColor,
                    backgroundColor: backgroundColor,
                    borderWidth: 2,
                    fill: config.type === 'line',
                    tension: 0.3,
                    pointRadius: values.length > 50 ? 0 : 3,
                    pointHoverRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: (ctx) => `${ctx.parsed.y} ${config.unit}`
                        }
                    }
                },
                scales: {
                    x: {
                        display: true,
                        ticks: { maxTicksLimit: 8, maxRotation: 0 },
                        grid: { display: false }
                    },
                    y: {
                        display: true,
                        grid: { color: 'rgba(0,0,0,0.05)' }
                    }
                }
            }
        });
    }

    function drawEmptyChart(config) {
        if (chart) chart.destroy();
        chart = new Chart(ctx, {
            type: 'line',
            data: { labels: ['Sin datos'], datasets: [{ data: [0], borderColor: '#dee2e6' }] },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { x: { display: false }, y: { display: false } }
            }
        });
    }

    function updateSummary(value, detail) {
        document.getElementById('summaryValue').textContent = value;
        document.getElementById('summaryDetail').textContent = detail;
    }

    async function fetchGlucoseReadings(patientId) {
        const resp = await fetch(`/api/glucose/readings/${patientId}`);
        if (!resp.ok) return [];
        return await resp.json();
    }

    async function loadGlucemiaChart() {
        const config = metricConfig.glucemia;

        try {
            let readings = [];
            if (pacienteId) {
                readings = await fetchGlucoseReadings(pacienteId);
            } else if (pacientesGlucemia.length > 0) {
                const batches = await Promise.all(
                    pacientesGlucemia.map(p => fetchGlucoseReadings(p.id)));
                const nameById = Object.fromEntries(pacientesGlucemia.map(p => [p.id, p.nombre]));
                batches.forEach((list, i) => {
                    const nombre = nameById[pacientesGlucemia[i].id];
                    list.forEach(r => readings.push({ ...r, pacienteNombre: nombre }));
                });
            }

            if (!readings || readings.length === 0) {
                const hint = pacienteId
                    ? 'Sin lecturas mySugr para este paciente (importá CSV o mail con PacienteId correcto)'
                    : 'Sin lecturas mySugr en ningún paciente';
                updateSummary('—', hint);
                document.getElementById('chartDataCount').textContent = '0 datos';
                drawEmptyChart(config);
                return;
            }

            const sorted = readings.sort((a, b) => a.readingDateTimeUtc.localeCompare(b.readingDateTimeUtc));
            const labels = sorted.map(r => {
                const t = r.readingDateTimeUtc.substring(0, 16).replace('T', ' ');
                return r.pacienteNombre ? `${t} · ${r.pacienteNombre}` : t;
            });
            const values = sorted.map(r => r.glucoseMgDl);

            document.getElementById('chartDataCount').textContent = `${values.length} datos`;
            const avg = Math.round(values.reduce((a, b) => a + b, 0) / values.length);
            const min = Math.min(...values);
            const max = Math.max(...values);
            const scope = pacienteId ? '' : ' · todos los pacientes';
            updateSummary(`${avg} mg/dL`, `Promedio ${avg} mg/dL · mínimo ${min} mg/dL · máximo ${max} mg/dL${scope}`);

            if (chart) chart.destroy();
            chart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Glucemia',
                        data: values,
                        borderColor: config.color,
                        backgroundColor: config.bgColor,
                        borderWidth: 2,
                        fill: true,
                        tension: 0.3,
                        pointRadius: values.length > 50 ? 0 : 3,
                        pointHoverRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: (ctx) => `${ctx.parsed.y} mg/dL` } }
                    },
                    scales: {
                        x: { display: true, ticks: { maxTicksLimit: 8, maxRotation: 0 }, grid: { display: false } },
                        y: { display: true, grid: { color: 'rgba(0,0,0,0.05)' } }
                    }
                }
            });
        } catch {
            updateSummary('—', 'Error al cargar datos de glucemia');
            drawEmptyChart(config);
        }
    }

    // Event listeners
    document.querySelectorAll('.btn-metric').forEach(btn => {
        btn.addEventListener('click', () => renderChart(btn.dataset.metric));
    });

    document.getElementById('metricSelect').addEventListener('change', (e) => {
        renderChart(e.target.value);
    });

    // Render inicial
    renderChart('fc');

    window.pulseraRealtimeReload = () => window.location.reload();
})();
</script>
}
